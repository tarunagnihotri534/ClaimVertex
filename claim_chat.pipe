{
	"components": [
		{
			"id": "chat_1",
			"provider": "chat",
			"config": {
				"hideForm": true,
				"mode": "Source",
				"parameters": {},
				"type": "chat"
			},
			"ui": {
				"position": { "x": 20, "y": 200 },
				"measured": { "width": 150, "height": 66 },
				"nodeType": "default",
				"formDataValid": true
			}
		},
		{
			"id": "embedding_1",
			"provider": "embedding_openai",
			"config": {
				"profile": "openai-5",
				"openai-5": {
					"apikey": "${ROCKETRIDE_OPENAI_KEY}"
				},
				"parameters": {}
			},
			"input": [
				{ "lane": "questions", "from": "chat_1" }
			],
			"ui": {
				"position": { "x": 240, "y": 200 },
				"measured": { "width": 150, "height": 66 },
				"nodeType": "default",
				"formDataValid": true
			}
		},

		{
			"id": "qdrant_1",
			"provider": "qdrant",
			"config": {
				"profile": "local",
				"local": {
					"host": "${ROCKETRIDE_QDRANT_HOST}",
					"port": 6333,
					"collection": "${ROCKETRIDE_COLLECTION_NAME}"
				},
				"parameters": {}
			},
			"input": [
				{ "lane": "questions", "from": "embedding_1" }
			],
			"ui": {
				"position": { "x": 460, "y": 200 },
				"measured": { "width": 150, "height": 135 },
				"nodeType": "default",
				"formDataValid": true
			}
		},
		{
			"id": "prompt_1",
			"provider": "prompt",
			"config": {
				"instructions": [
					"You are ClaimPilot AI, an intelligent insurance claim assistant.",
					"Use the provided context documents to answer questions accurately and cite claim details clearly."
				],
				"parameters": {}
			},
			"input": [
				{ "lane": "documents", "from": "qdrant_1" },
				{ "lane": "questions", "from": "qdrant_1" }
			],
			"ui": {
				"position": { "x": 680, "y": 200 },
				"measured": { "width": 150, "height": 66 },
				"nodeType": "default",
				"formDataValid": true
			}
		},
		{
			"id": "llm_1",
			"provider": "llm_openai",
			"config": {
				"profile": "openai-5",
				"openai-5": {
					"apikey": "${ROCKETRIDE_OPENAI_KEY}"
				},
				"parameters": {}
			},
			"input": [
				{ "lane": "questions", "from": "prompt_1" }
			],
			"ui": {
				"position": { "x": 900, "y": 200 },
				"measured": { "width": 150, "height": 66 },
				"nodeType": "default",
				"formDataValid": true
			}
		},
		{
			"id": "response_1",
			"provider": "response_answers",
			"config": {
				"laneName": "answers"
			},
			"input": [
				{ "lane": "answers", "from": "llm_1" }
			],
			"ui": {
				"position": { "x": 1120, "y": 200 },
				"measured": { "width": 150, "height": 66 },
				"nodeType": "default",
				"formDataValid": true
			}
		}
	],
	"project_id": "a01b2c3d-4e5f-47a8-b90c-1d2e3f4a5b6c",
	"viewport": { "x": 0, "y": 0, "zoom": 1 },
	"version": 1
}

